# ==============================================================================
# Verdiqt API — Environment Variable Template
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development

# Database (MongoDB connection string — Mongoose)
# Accepts either MONGODB_URI or DATABASE_URL
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/verdiqt?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/verdiqt?retryWrites=true&w=majority
MONGODB_DB_NAME=verdiqt

# AI Engine (Google Gemini API — Used by Mediation Engine)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-4-hydrogen

# Anthropic Claude API (Alternative model support)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Cloudinary (File storage for digital evidence & milestone submissions)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Admin SDK (Token verification & custom token minting)
# Paste the base64-encoded service account JSON string
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json
# Optional alternative: path to service account JSON file on disk
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Resend (Email notifications for dispute status & releases)
RESEND_API_KEY=re_your_resend_api_key

# Frontend Application Origin (For CORS whitelist & email link generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Platform Administration Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password
